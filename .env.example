# Pick ONE backend. Leave everything unset to default to a local Ollama server.

# Option A: local, zero-cost — install https://ollama.com, then `ollama pull llama3.1`
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Option B: Anthropic API key
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Option C: OpenAI API key
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option D: Groq API key (free tier, OpenAI-compatible)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# Force a specific backend instead of auto-detecting from the keys above:
# LLM_PROVIDER=anthropic
